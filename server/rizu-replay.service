[Unit]
Description=Rizu replay server
After=network.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=rizu-replay
Environment=RIZU_DATABASE=/var/lib/rizu-replay/scores.sqlite3
Environment=RIZU_CATALOG=/var/lib/rizu-replay/catalog.sqlite
Environment=RIZU_CATALOG_URL=https://s3.kuudere.fun/catalog.sqlite
ExecStart=/opt/node-v24.20.0/bin/node /srv/rizu-replay/index.ts
Restart=on-failure
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
