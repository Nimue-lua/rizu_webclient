[Unit]
Description=Rizu replay server
After=network.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=rizu-replay
Environment=RIZU_DATABASE=/var/lib/rizu-replay/scores.sqlite3
Environment=RIZU_CATALOG=/var/lib/rizu-replay/catalog.sqlite
Environment=RIZU_CATALOG_URL=https://s3.kuudere.fun/catalog.sqlite
Environment=RIZU_CHART_CACHE=/var/lib/rizu-replay/chart-cache
Environment=RIZU_WEB_ROOT=/srv/rizu-replay/repo/dist
WorkingDirectory=/srv/rizu-replay/repo
ExecStart=/srv/rizu-replay/repo/node_modules/.bin/tsx /srv/rizu-replay/repo/server/replay-server/index.ts
Restart=on-failure
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
