#!/usr/bin/env bash

set -Eeuo pipefail
export LC_ALL=C

readonly ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly DEPLOY_HOST="${DEPLOY_HOST:-root@nimue.mom}"
readonly REPOSITORY_URL="${REPOSITORY_URL:-https://github.com/Nimue-lua/rizu_webclient.git}"
readonly BRANCH="${BRANCH:-main}"
readonly SERVER_ROOT="${SERVER_ROOT:-/srv/rizu-replay/repo}"
readonly NODE_ROOT="${NODE_ROOT:-/opt/node-v24.20.0}"
readonly LIBRARY_DIR="${LIBRARY_DIR:-/media/SSD/s3_test}"
readonly LIBRARY_REMOTE="${LIBRARY_REMOTE:-catalog:rizu.catalog}"
readonly LIBRARY_URL="${LIBRARY_URL:-https://s3.kuudere.fun}"
readonly CHARTS_DIR="$LIBRARY_DIR/charts"

usage() {
  cat <<'EOF'
Usage: ./rizu [command]

Commands:
  previews        Generate immutable charts, audio, previews, and backgrounds
  catalog         Create or replace catalog.sqlite and catalog.sqlite.gz
  upload-songs    Upload immutable assets to Selectel
  upload-catalog  Upload the gzipped catalog to Selectel
  deploy          Check, build, and deploy the application
  restart-server  Restart the deployed server without rebuilding

Run without a command to open the interactive menu.
EOF
}

require_commands() {
  local command
  for command in "$@"; do
    command -v "$command" >/dev/null || {
      printf 'Required command not found: %s\n' "$command" >&2
      exit 1
    }
  done
}

require_charts() {
  if [[ ! -d "$CHARTS_DIR" ]]; then
    printf 'Chart directory not found: %s\n' "$CHARTS_DIR" >&2
    exit 1
  fi
}

generate_previews() {
  require_commands node ffmpeg
  require_charts
  node "$ROOT_DIR/server/cache-charts.mjs" \
    --charts "$CHARTS_DIR" \
    --chart-assets "$LIBRARY_DIR/chart-files/v1" \
    --audio "$LIBRARY_DIR/audio/v1" \
    --audio-previews "$LIBRARY_DIR/audio-previews/v1" \
    --background-previews "$LIBRARY_DIR/backgrounds/v2" \
    --skip-database
}

create_catalog() {
  require_commands node
  require_charts
  node "$ROOT_DIR/server/cache-charts.mjs" \
    --charts "$CHARTS_DIR" \
    --client-database "$LIBRARY_DIR/catalog.sqlite" \
    --chart-assets "$LIBRARY_DIR/chart-files/v1" \
    --audio "$LIBRARY_DIR/audio/v1" \
    --audio-previews "$LIBRARY_DIR/audio-previews/v1" \
    --background-previews "$LIBRARY_DIR/backgrounds/v2" \
    --skip-previews
}

upload_songs() {
  require_commands rclone
  local directory
  for directory in chart-files/v1 audio/v1 audio-previews/v1 backgrounds/v2; do
    if [[ ! -d "$LIBRARY_DIR/$directory" ]]; then
      printf 'Generated asset directory not found: %s (run previews first)\n' "$LIBRARY_DIR/$directory" >&2
      exit 1
    fi
  done

  rclone copy "$LIBRARY_DIR/chart-files/v1" "$LIBRARY_REMOTE/chart-files/v1" \
    --metadata \
    --metadata-set "cache-control=public, max-age=31536000, immutable" \
    --metadata-set "content-type=text/plain; charset=utf-8" \
    --progress
  rclone copy "$LIBRARY_DIR/audio/v1" "$LIBRARY_REMOTE/audio/v1" \
    --metadata \
    --metadata-set "cache-control=public, max-age=31536000, immutable" \
    --metadata-set "content-type=audio/webm" \
    --progress
  rclone copy "$LIBRARY_DIR/audio-previews/v1" "$LIBRARY_REMOTE/audio-previews/v1" \
    --metadata \
    --metadata-set "cache-control=public, max-age=31536000, immutable" \
    --metadata-set "content-type=audio/webm" \
    --progress
  rclone copy "$LIBRARY_DIR/backgrounds/v2" "$LIBRARY_REMOTE/backgrounds/v2" \
    --metadata \
    --metadata-set "cache-control=public, max-age=31536000, immutable" \
    --metadata-set "content-type=image/avif" \
    --progress
  printf 'Immutable assets uploaded: %s\n' "$LIBRARY_URL"
}

upload_catalog() {
  require_commands rclone curl
  local catalog="$LIBRARY_DIR/catalog.sqlite.gz"
  if [[ ! -f "$catalog" ]]; then
    printf 'Catalog not found: %s (run catalog first)\n' "$catalog" >&2
    exit 1
  fi

  rclone copyto "$catalog" "$LIBRARY_REMOTE/catalog.sqlite" \
    --metadata \
    --metadata-set "cache-control=no-cache" \
    --metadata-set "content-type=application/vnd.sqlite3" \
    --metadata-set "content-encoding=gzip" \
    --ignore-times \
    --progress
  curl -fsS --compressed "$LIBRARY_URL/catalog.sqlite" >/dev/null
  printf 'Catalog uploaded: %s/catalog.sqlite\n' "$LIBRARY_URL"
}

deploy_application() {
  require_commands ssh
  ssh "$DEPLOY_HOST" "bash -s" -- "$REPOSITORY_URL" "$BRANCH" "$SERVER_ROOT" "$NODE_ROOT" <<'REMOTE'
set -Eeuo pipefail

repository_url="$1"
branch="$2"
server_root="$3"
node_root="$4"
export PATH="$node_root/bin:$PATH"

command -v git >/dev/null
command -v npm >/dev/null
command -v curl >/dev/null

if [[ ! -d "$server_root/.git" ]]; then
  git clone --branch "$branch" --single-branch "$repository_url" "$server_root"
else
  git -C "$server_root" fetch origin "$branch"
  git -C "$server_root" merge --ff-only FETCH_HEAD
fi

rm -rf -- "$server_root/.dist.new"
npm --prefix "$server_root" ci
npm --prefix "$server_root" run build -- --outDir .dist.new

rm -rf -- "$server_root/dist.old"
if [[ -d "$server_root/dist" ]]; then
  mv -- "$server_root/dist" "$server_root/dist.old"
fi
mv -- "$server_root/.dist.new" "$server_root/dist"

install -m 0644 "$server_root/server/rizu-replay.service" /etc/systemd/system/rizu-replay.service
systemctl daemon-reload
systemctl restart rizu-replay
systemctl --quiet is-active rizu-replay
curl --fail --silent --show-error --retry 30 --retry-delay 1 --retry-connrefused \
  http://127.0.0.1:8765/api/health
rm -rf -- "$server_root/dist.old"
REMOTE

  printf '\nRizu client and server deployed from %s (%s).\n' "$REPOSITORY_URL" "$BRANCH"
}

restart_server() {
  require_commands ssh
  ssh "$DEPLOY_HOST" 'set -Eeuo pipefail
systemctl restart rizu-replay
systemctl --quiet is-active rizu-replay
curl --fail --silent --show-error --retry 30 --retry-delay 1 --retry-connrefused \
  http://127.0.0.1:8765/api/health'
  printf '\nRizu server restarted.\n'
}

choose_command() {
  printf '%s\n' \
    'Rizu maintenance' \
    '1) Generate immutable library assets' \
    '2) Create/Update catalog.sqlite' \
    '3) Upload immutable assets to Selectel' \
    '4) Upload catalog.sqlite' \
    '5) Deploy application' \
    '6) Restart server' \
    'q) Quit' >&2
  read -r -p '> ' choice
  case "$choice" in
    1) printf 'previews' ;;
    2) printf 'catalog' ;;
    3) printf 'upload-songs' ;;
    4) printf 'upload-catalog' ;;
    5) printf 'deploy' ;;
    6) printf 'restart-server' ;;
    q|Q) printf 'quit' ;;
    *) printf 'Unknown selection: %s\n' "$choice" >&2; exit 2 ;;
  esac
}

command_name="${1:-}"
if [[ -z "$command_name" ]]; then
  command_name="$(choose_command)"
elif (( $# > 1 )); then
  usage >&2
  exit 2
fi

case "$command_name" in
  previews) generate_previews ;;
  catalog) create_catalog ;;
  upload-songs) upload_songs ;;
  upload-catalog) upload_catalog ;;
  deploy) deploy_application ;;
  restart-server|restart_server) restart_server ;;
  quit) exit 0 ;;
  -h|--help|help) usage ;;
  *) printf 'Unknown command: %s\n\n' "$command_name" >&2; usage >&2; exit 2 ;;
esac
