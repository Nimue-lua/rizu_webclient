server {
	listen 80;
	listen [::]:80;
	server_name rizu.nimue.mom;

	root /srv/rizu/dist;

	location / {
		try_files $uri $uri/ /index.html;
	}

	location = /catalog.sqlite {
		alias /srv/rizu/public/catalog.sqlite;
		add_header Cache-Control "no-cache" always;
	}

	location /charts/ {
		alias /srv/rizu/public/charts/;
		add_header Cache-Control "public, max-age=31536000, immutable" always;
	}

	location /chart-previews/ {
		alias /srv/rizu/public/chart-previews/;
		add_header Cache-Control "public, max-age=31536000, immutable" always;
	}

	location /audio-previews/ {
		alias /srv/rizu/public/audio-previews/;
		add_header Cache-Control "public, max-age=31536000, immutable" always;
	}

}
