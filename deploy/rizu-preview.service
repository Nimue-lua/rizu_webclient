[Unit]
Description=Rizu WebRTC preview server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/srv/rizu
ExecStart=/srv/rizu/bin/rizu-preview -address 127.0.0.1:8090 -udp-address :50000 -public-ip 64.188.126.79 -catalog /srv/rizu/server/catalog.sqlite -public /srv/rizu/public -ffmpeg /usr/bin/ffmpeg
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/srv/rizu

[Install]
WantedBy=multi-user.target
